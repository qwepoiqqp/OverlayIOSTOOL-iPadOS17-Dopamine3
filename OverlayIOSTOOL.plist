<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- Inject vào MỌI tiến trình UIKit: SpringBoard (render overlay) + tất cả app
		     (relay toạ độ chạm để hitbox hoạt động ngay trong app). %ctor tự định tuyến:
		     chỉ SpringBoard vẽ overlay; app thật chỉ chạy relay nhẹ; tiến trình khác thoát sớm. -->
		<key>Classes</key>
		<array>
			<string>UIApplication</string>
		</array>
	</dict>
</dict>
</plist>
